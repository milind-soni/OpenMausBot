<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Opt-in "always on" background connection (Settings toggle, default off).
      FOREGROUND_SERVICE_CONNECTED_DEVICE rather than dataSync: this service
      exists to keep the pairing to the paired computer alive, not to move
      data in bulk, and dataSync foreground services face a ~6h/24h system
      timeout on Android 15+ that connectedDevice does not.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      Pairing QR only, and asked for only when the scanner is opened. The app is
      fully usable without it: the NSD list and a typed address are the other two
      ways in (§6), so a camera the user never grants costs nothing.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!--
      Composer dictation only. Asked at the mic button, never at startup — the
      app is fully usable without it, and the IME's own mic is not a substitute
      for this lifecycle (frozen base, partials, teardown).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!--
      Android 13+ NSD / Wi-Fi peer discovery. neverForLocation: we only browse
      for _openmausbot._tcp, never derive physical location from the scan.
      Without this (and the multicast permission), NsdManager returns an empty
      list silently — the same footgun as missing NSLocalNetworkUsageDescription
      on iOS (briefing §19).
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        android:minSdkVersion="33" />
    <!--
      Android 17 (API 37): runtime local-network permission. Without the
      declaration and a grant, NSD browse and plain LAN sockets to the
      companion are blocked the same way iOS blocks Bonjour without
      NSLocalNetworkUsageDescription.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        android:minSdkVersion="37" />

    <!--
      Package visibility (API 30+): without this, SpeechRecognizer cannot see
      RecognitionService providers and isRecognitionAvailable() can falsely
      report none — dictation would never start on modern devices.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".OpenMausApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenMausMobile">

        <!--
          persistNever: nothing about this Activity, its launching Intent
          included, may be written to task state that survives a reboot. It only
          ever receives ACTION_MAIN or the sanitized Intent PairingLinkActivity
          builds, but a one-time pairing credential is not the kind of thing to
          protect by one layer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:persistableMode="persistNever"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The deep-link door. A pairing URL carries a one-time credential, and the
          system keeps a copy of an Activity's launching Intent — handing it back
          on restart, and under the default persistRootOnly writing a root
          Activity's Intent across a reboot. This one is therefore never the root
          of the main task (its own taskAffinity), never kept in history, never in
          recents, and never persisted. It moves the invite into process memory
          and starts MainActivity with an Intent carrying no data and no extras.
        -->
        <activity
            android:name=".PairingLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:persistableMode="persistNever"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="openmausbot" />
            </intent-filter>
        </activity>
        <!--
          Inbound share. The sending app's content URIs are granted to this
          Activity; it copies them into the app cache, starts MainActivity with
          no extras, finishes, and only then deposits the local payload in
          process memory. Same trampoline shape as pairing, for the same
          reason: MainActivity is the root of the main task.
          configChanges: no UI — absorb rotation/etc so a mid-copy recreation
          cannot orphan the first copy against a wiped inbox.
        -->
        <activity
            android:name=".ShareReceiveActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:persistableMode="persistNever"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>
        </activity>
        <!--
          The 25-second linger anchor (iOS buys the same window with
          beginBackgroundTask). An ordinary started service: no intent filter,
          no binder, no foreground service permission, no foregroundServiceType,
          and nothing to export — its only caller is this process, and its only
          effect is keeping this process out of the cached class while the
          window is open. stopWithTask: swiping the task away is the user
          saying they are done, so the window goes with it.
        -->
        <service
            android:name=".lifecycle.SessionLingerService"
            android:exported="false"
            android:stopWithTask="true" />

        <!--
          The opt-in "always on" counterpart to SessionLingerService above.
          stopWithTask="false" is the whole point: this must keep running when
          the user swipes the app away, which is exactly what the 25-second
          linger window above does not attempt.
        -->
        <service
            android:name=".lifecycle.AlwaysOnConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <!--
          Restarts AlwaysOnConnectionService after a reboot, only when the user
          left the Settings toggle on. Not exported beyond what BOOT_COMPLETED
          requires; carries no data and does nothing when the toggle is off.
        -->
        <receiver
            android:name=".lifecycle.AlwaysOnBootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Share sheet hand-off for exported transcripts. Not exported, no
          granted URI permissions by default: each share grants read access to
          one file for one Intent, and only for the receiving app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.transcripts"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
