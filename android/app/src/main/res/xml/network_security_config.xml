<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local/Tailscale pairing is explicit in-app. Hosted routes still require valid HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
