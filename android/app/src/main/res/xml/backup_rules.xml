<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup (API 23–30): exclude the Keystore-backed token prefs, and the
  permission-prompt bookkeeping.

  Connection DataStore may back up; the device token must not. The permission
  prefs are not a secret, but they record that this install has already used up
  its notification prompt — restoring that onto a fresh install, where the OS has
  reset the permission and would happily ask again, would show "Open notification
  settings" for a prompt that was never spent here.

  The onboarding markers are the same kind of device-local truth: they record
  which first-run steps this install has already shown and answered. Carried onto
  a fresh install they would skip the welcome and the notification explanation
  for someone who has seen neither.
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="companion_device_token.xml" />
    <exclude
        domain="sharedpref"
        path="__androidx_security_crypto_encrypted_prefs__.xml" />
    <exclude
        domain="sharedpref"
        path="astra.permissions.xml" />
    <exclude
        domain="sharedpref"
        path="astra.onboarding.xml" />
</full-backup-content>
