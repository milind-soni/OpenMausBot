<?xml version="1.0" encoding="utf-8"?>
<!--
  Device transfer / cloud backup (API 31+): never copy the device token, and never
  copy the permission-prompt bookkeeping.

  EncryptedSharedPreferences file is listed explicitly; Keystore key material is
  already device-bound, but the ciphertext must not leave the device either. The
  permission prefs travel to a device whose OS has its own idea of what has been
  asked, so carrying ours across would misread a re-askable install as one that
  had spent its prompt. The onboarding markers travel the same way and are
  excluded for the same reason: they say which first-run steps this install has
  already shown.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="companion_device_token.xml" />
        <exclude
            domain="sharedpref"
            path="astra.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="astra.onboarding.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="companion_device_token.xml" />
        <exclude
            domain="sharedpref"
            path="astra.permissions.xml" />
        <exclude
            domain="sharedpref"
            path="astra.onboarding.xml" />
    </device-transfer>
</data-extraction-rules>
