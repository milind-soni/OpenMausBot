# Install as /etc/openmausbot/admin.env, root:root, mode 0600.
# Replace every example value before starting. This is not a shell script.
OMB_ADMIN_URL=https://admin.example.com
OMB_ADMIN_NAME=OpenMausBot
OMB_ADMIN_EMAILS=owner@example.com
# Deliberately too short to start: replace with `openssl rand -hex 32` output.
OMB_ADMIN_SECRET=CHANGE_ME
OMB_ADMIN_DATA_DIR=/var/lib/openmausbot-admin
OMB_ADMIN_SOCKET=/run/openmausbot-admin/http.sock
OMB_FLEET_SOCKET=/run/openmausbot/fleet.sock
OMB_ADMIN_SMTP_URL=smtps://USERNAME:PERCENT_ENCODED_PASSWORD@smtp.example.com:465
OMB_ADMIN_MAIL_FROM="OpenMausBot <access@example.com>"

# Optional: configure both values in a provider's pair, or omit both.
# OMB_ADMIN_GOOGLE_CLIENT_ID=
# OMB_ADMIN_GOOGLE_CLIENT_SECRET=
# OMB_ADMIN_GITHUB_CLIENT_ID=
# OMB_ADMIN_GITHUB_CLIENT_SECRET=
