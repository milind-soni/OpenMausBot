COMPOSE_PROJECT_NAME=openmaus-test
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
OMB_PUBLIC_URL=http://localhost:8080
# Generate a new private value; this is only for Codex -> local gateway.
OPENMAUS_MODEL_GATEWAY_KEY=

# Optional managed connected-apps installation, provisioned separately.
OMB_COMPOSIO_BROKER_URL=
OMB_COMPOSIO_BROKER_TOKEN=

AZURE_MODEL=azure/gpt-5.6-sol
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

GEMINI_API_KEY=

# Set a Claude model/inference-profile ID available in your AWS region.
BEDROCK_MODEL=bedrock/converse/YOUR_CLAUDE_MODEL_OR_INFERENCE_PROFILE_ID
AWS_REGION_NAME=us-east-1
# Use either a Bedrock bearer key or AWS credentials (session token if temporary).
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
