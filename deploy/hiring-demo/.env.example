# Public hostname for the demo, with automatic HTTPS. It must resolve to this machine, with ports 80 and 443 open.
DOMAIN=hiring.example.com

# Who may sign in with an emailed code at https://<DOMAIN>/pair. Addresses or @domain entries, comma-separated.
# Admins get full access (you). Members get chat and approvals only: the right level for clients trying the demo.
# Empty means pairing links only (docker compose exec omb node dist-server/openmausbot.js pair).
OMB_SIGNIN_EMAILS=
OMB_SIGNIN_MEMBER_EMAILS=

# Models for the desk (Claude Code engine). The Desk Manager, Matcher and Submission Writer use the strong one.
DESK_STRONG_MODEL=claude-opus-5-5
DESK_FAST_MODEL=claude-sonnet-5-5

# Engine CLIs baked into the server image (space-separated npm packages).
ENGINES=@anthropic-ai/claude-code

# Only for trying the stack on a laptop: other host ports instead of 80/443.
# HTTP_PORT=8080
# HTTPS_PORT=8443
