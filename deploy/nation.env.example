# Server-side values only. Copy placeholders into your process configuration.
# Never put model keys or these settings in VITE_* variables.
OPENROUTER_API_KEY=replace-with-server-held-key
NATION_PRODUCT_OWNER=0
NATION_PRODUCT_ADMIN=0
# Leave unset to reuse existing data automatically. Do not point an existing
# installation at an empty directory.
# NATION_DATA_DIR=/root/.nationteamchat

NATION_FREE_CREDIT_USD=3
NATION_CREDIT_MARKUP=1.0
NATION_LOW_BALANCE_USD=0.50
NATION_PACKS_USD=15,49,99
NATION_FREE_GRANTS_PER_IP_PER_DAY=2
# Starter credits in all per UTC day, whatever networks ask (one per inbox as well).
NATION_FREE_GRANTS_PER_DAY=1000
NATION_CONFIRMATIONS=3
# Top-up runs on Robinhood Chain (4663) only; Base is retired. An empty treasury
# hides Top up and displays Top up coming soon. Approved values are in
# nation-robinhood.env.
NATION_TREASURY_ROBINHOOD=
NATION_RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
# The $NATION pay option appears only while a USD price is set. $NATION buyers
# send NATION_TOKEN_DISCOUNT less for the same credit (0.2 = 20% off; 0 = none).
NATION_TOKEN_USD_PRICE=
NATION_TOKEN_DISCOUNT=0.2
NATION_IMAGE_MODEL=openai/gpt-image-2
# Enable only behind an operator-controlled proxy that replaces X-Real-IP.
NATION_TRUST_PROXY=0
# Behind the NATION web app on Vercel: the header in which Vercel names each
# visitor, so sign-in and starter-credit limits count visitors rather than
# Vercel. Leave it unset until the owner's check on the live path
# (GET /api/admin/credits/client-address) shows, under "headers", your own
# public address in x-vercel-forwarded-for, and a different one from another
# network. Then set it, and check again that "address" is yours.
# NATION_CLIENT_IP_HEADER=x-vercel-forwarded-for
# Optional additional disposable-email domains, comma-separated.
NATION_DISPOSABLE_EMAIL_DOMAINS=

# Web front ends that reach this server through a rewrite proxy (the NATION
# web app on Vercel: /swarm/api/* -> this server). Their Origin differs from
# this server's Host, so list them or every signed-in write is refused with
# "forbidden: cross-origin request". Exact https origins only; never "*".
NATION_TRUSTED_ORIGINS=https://thenation.city
# Preview deployments: https origins with one "*" inside the first host label,
# pinned by a literal project prefix and team suffix. "*.vercel.app" and other
# wildcards spanning labels are rejected.
NATION_TRUSTED_ORIGIN_PATTERNS=https://nation-team-chat-*-aurk1.vercel.app

# ── Public sign-up: email sign-in link, one workspace per account ──────────
# Off unless 1. Anyone can then sign in with an emailed link; the first
# sign-in creates their own workspace (its own server process and data
# directory under <data dir>/workspaces/). Addresses on the desk's own
# sign-in list (OMB_SIGNIN_EMAILS for admins, OMB_SIGNIN_MEMBER_EMAILS for
# members) keep signing in to this server's desk instead.
NATION_ACCOUNTS=0
# Where sign-in links open. Required for sign-in links on a public server.
OMB_PUBLIC_URL=https://thenation.city/swarm
# The founder's own address(es): signed in, they reach this desk as admin.
OMB_SIGNIN_EMAILS=you@example.com
# Mail for sign-in links: your provider's SMTP address with its credentials
# (smtps://user:password@host:465, or smtp://user:password@host:587 with
# STARTTLS) and the sender. Keep them in the process environment only.
NATION_SMTP_URL=
NATION_MAIL_FROM="Nation Team Chat <login@thenation.city>"
# Limits (defaults shown). A running workspace is a server process of about
# 200 MB; workspaces stop after the idle time unless a turn or a routine keeps
# them running, and start again on their next request.
# NATION_MAGIC_LINK_TTL_MINUTES=15
# NATION_MAGIC_LINKS_PER_HOUR=500
# NATION_MAGIC_LINKS_PER_NETWORK_PER_HOUR=20
# NATION_WORKSPACE_MAX_TOTAL=500
# NATION_WORKSPACE_MAX_RUNNING=8
# NATION_WORKSPACE_IDLE_MINUTES=30
# Each workspace runs this server's own entry point. Under a process manager
# that wraps the script (PM2 is detected), or to be explicit, name it:
# NATION_WORKSPACE_SERVER_ENTRY=/path/to/nation-team-chat/dist-server/index.js
# Behind the web app's rewrite proxy, every browser reaches this server from
# the proxy's few addresses, so per-network limits (sign-in links, starter
# credit per network per day) count the proxy unless NATION_CLIENT_IP_HEADER
# names the visitor. See NATION_CLIENT_IP_HEADER above.
# Each workspace gets NATION's cloud computers when this server holds the
# cloud computer credential (Admin, or BOX_TOKEN here), and the built-in
# browser, behind an egress guard, when its browser engine is ready. Set
# either to 0 to switch it off for every workspace from its next start.
# NATION_WORKSPACE_COMPUTERS=1
# NATION_WORKSPACE_BROWSER=1
# Isolated coding on each member's assigned Daytona computer. Prepare the
# snapshot with deploy/install-isolated-coding.sh and verify it first; see
# docs/verification/isolated-coding.md. Never enable member host engines.
NATION_CODING_ENABLED=0
# Exact OpenRouter OpenAI model ID validated with the Responses API.
NATION_CODING_MODEL=
# Public HTTPS origin reaching this server's /api/coding-model/* directly.
# This is an origin without /swarm or another path prefix.
NATION_CODING_PUBLIC_ORIGIN=
# Workspaces have homes of their own and do not find a Chrome installed under
# this server's home: set the exact Chrome this server runs (docs/deploy-vps.md).
# AGENT_BROWSER_EXECUTABLE_PATH=/path/to/chrome

# ── NATION wallet: a passkey-held embedded wallet for Full Plans ───────────
# NATION's Turnkey parent organization and an API key for it (P-256:
# compressed public key and private key, both hex). Server-side only; all
# three empty hides the NATION wallet. The key can create a wallet for an
# account but cannot move its funds: only the account's passkey can.
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# TURNKEY_API_BASE_URL=https://api.turnkey.com
# Seconds between payment scans (5 to 300).
# NATION_CREDIT_SCAN_SECONDS=30
