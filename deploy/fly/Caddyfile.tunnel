# Edge for a Cloud home on a server reached through a Cloudflare tunnel
# (docs/cloud-pro.md, "On your own server"): the same routes as Caddyfile on
# :8080, for the connector, and on 127.0.0.1:8812, where the control plane
# points the tunnel. cloudflared runs in this home, as maus (the launcher
# starts it: server/cloud-home-start.ts), and connects only from loopback, so
# that listener alone believes Cf-Connecting-IP, which Cloudflare's edge sets;
# :8080 trusts only the proxies the owner names. The address feeds the pairing
# lockout, never authorization.
{
	admin off
	auto_https off
	persist_config off
	servers :8080 {
		trusted_proxies static {$OMB_CLOUD_EDGE_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers {$OMB_CLOUD_EDGE_CLIENT_IP_HEADER}
	}
	servers 127.0.0.1:8812 {
		trusted_proxies static 127.0.0.1/32
		trusted_proxies_strict
		client_ip_headers Cf-Connecting-IP
	}
}

:8080 {
	import edge-routes.caddy
}

:8812 {
	bind 127.0.0.1
	import edge-routes.caddy
}
