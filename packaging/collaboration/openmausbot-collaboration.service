[Unit]
Description=OpenMausBot secure collaboration service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openmausbot
Group=openmausbot
WorkingDirectory=/opt/openmausbot/current
ExecStart=/usr/bin/node /opt/openmausbot/current/dist-server/collaboration-headless.js
Environment=OMB_DATA_DIR=/var/lib/openmausbot-collaboration
Environment=OMB_DINGTALK_ENABLED=1
Environment=OMB_DINGTALK_CREDENTIAL_FILE=%d/dingtalk.json
Environment=OMB_OWNER_ALERT_WEBHOOK_FILE=%d/owner-alert-webhook.url
Environment=OMB_BACKUP_KEY_FILE=%d/backup-encryption.key
Environment=OMB_EXECUTION_MODE=observe_plan_only
Environment=OMB_EXECUTION_ENABLED=0
LoadCredential=dingtalk.json:/etc/openmausbot-collaboration/dingtalk.json
LoadCredential=owner-alert-webhook.url:/etc/openmausbot-collaboration/owner-alert-webhook.url
LoadCredential=backup-encryption.key:/etc/openmausbot-collaboration/backup-encryption.key
StateDirectory=openmausbot-collaboration
LogsDirectory=openmausbot-collaboration
RuntimeDirectory=openmausbot-collaboration
UMask=0077
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/openmausbot-collaboration /var/log/openmausbot-collaboration

[Install]
WantedBy=multi-user.target
