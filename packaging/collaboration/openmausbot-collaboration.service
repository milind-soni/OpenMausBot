[Unit]
Description=OpenMausBot secure collaboration service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openmausbot
Group=openmausbot
WorkingDirectory=/opt/openmausbot/current
ExecStart=/usr/bin/node /opt/openmausbot/current/dist-server/collaboration-headless.js
Environment=OMB_DATA_DIR=/var/lib/openmausbot-collaboration
Environment=OMB_DINGTALK_ENABLED=1
Environment=OMB_DINGTALK_CREDENTIAL_FILE=%d/dingtalk.json
Environment=OMB_CONTAINMENT_VERIFIER_KEY_FILE=%d/containment-hmac.key
Environment=OMB_BACKUP_KEY_FILE=%d/backup-encryption.key
Environment=OMB_CGROUP_ROOT=/sys/fs/cgroup/openmausbot
Environment=OMB_BOOT_GENERATION_FILE=/proc/sys/kernel/random/boot_id
LoadCredential=dingtalk.json:/etc/openmausbot-collaboration/dingtalk.json
LoadCredential=containment-hmac.key:/etc/openmausbot-collaboration/containment-hmac.key
LoadCredential=backup-encryption.key:/etc/openmausbot-collaboration/backup-encryption.key
StateDirectory=openmausbot-collaboration
LogsDirectory=openmausbot-collaboration
RuntimeDirectory=openmausbot-collaboration
UMask=0077
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=false
Delegate=yes
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/openmausbot-collaboration /var/log/openmausbot-collaboration /sys/fs/cgroup/openmausbot

[Install]
WantedBy=multi-user.target
