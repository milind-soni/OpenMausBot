            "type": "boolean"
          },
          "prompt": {
            "default": false,
            "type": "boolean"
          },
          "session": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "start_session",
      "description": "Session bookkeeping; return the session id/state.",
      "inputSchema": {
        "properties": {
          "capture_scope": {
            "enum": [
              "auto",
