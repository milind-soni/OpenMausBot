{
  "tools": [
    {
      "name": "get_screen_size",
      "description": "Return the main display size in screen points and pixels.",
      "inputSchema": {
        "properties": {
          "session": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_desktop_state",
      "description": "Capture the whole desktop, frontmost app, and screen size.",
      "inputSchema": {
        "properties": {
          "max_image_dimension": {
            "minimum": 0,
            "type": "integer"
          },
          "screenshot_out_file": {
            "type": "string"
          },
          "session": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "list_windows",
      "description": "List windows with window_id, pid, app, title, bounds, layer and on-screen state.",
      "inputSchema": {
        "properties": {
          "app": {
            "type": "string"
          },
          "on_screen_only": {
            "type": "boolean"
          },
          "pid": {
            "type": "integer"
          },
          "session": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "list_apps",
      "description": "List running apps with pid, name, bundle id, active and hidden state.",
      "inputSchema": {
        "properties": {
          "session": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "launch_app",
      "description": "Launch an app by name or bundle id, or open URLs.",
      "inputSchema": {
        "properties": {
          "additional_arguments": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "bundle_id": {
            "type": "string"
          },
          "creates_new_application_instance": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "webkit_inspector_port": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "bring_to_front",
      "description": "Activate an app and optionally raise one of its windows. This takes focus.",
      "inputSchema": {
        "properties": {
          "pid": {
            "type": "integer"
          },
          "session": {
            "type": "string"
          },
          "window_id": {
            "type": "integer"
          }
        },
        "required": [
          "pid"
        ]
      }
    },
    {
      "name": "get_window_state",
      "description": "Read a window’s accessibility tree and screenshot. Every element line carries an element_token for click, type_text, set_value and hotkey. Prefer tokens over coordinates.",
      "inputSchema": {
        "properties": {
          "capture_mode": {
            "enum": [
              "ax",
              "vision"
            ],
            "type": "string"
          },
          "display_only": {
            "type": "boolean"
          },
          "full_output": {
            "type": "boolean"
          },
          "include_accessibility_tree": {
            "type": "boolean"
          },
          "include_screenshot": {
            "type": "boolean"
          },
          "max_depth": {
            "minimum": 1,
            "type": "integer"
          },
          "max_dimension": {
            "minimum": 1,
            "type": "integer"
          },
          "max_elements": {
            "minimum": 1,
            "type": "integer"
          },
          "max_image_dimension": {
            "minimum": 0,
            "type": "integer"
          },
          "pid": {
            "type": "integer"
          },
          "query": {
            "type": "string"
          },
          "screenshot_format": {
            "enum": [
              "png",
              "jpeg"
            ],
            "type": "string"
          },
          "screenshot_out_file": {
            "type": "string"
          },
          "screenshot_quality": {
            "maximum": 95,
            "minimum": 1,
            "type": "integer"
          },
          "session": {
            "type": "string"
          },
          "since": {
            "type": "string"
          },
          "timeout_ms": {
            "default": 1000,
            "maximum": 120000,
            "minimum": 100,
            "type": "integer"
          },
          "tree_format": {
            "enum": [
              "markdown",
              "elements",
              "both"
            ],
            "type": "string"
          },
          "verbose": {
            "type": "boolean"
          },
          "window_id": {
            "type": "integer"
          }
        },
        "required": [
          "pid",
          "window_id"
        ]
      }
    },
    {
      "name": "get_accessibility_tree",
      "description": "Read the frontmost app’s accessibility tree.",
      "inputSchema": {
        "properties": {
          "session": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "click",
      "description": "Click an element token or a screen point. Background by default; foreground only when the person asked.",
      "inputSchema": {
        "properties": {
          "action": {
            "type": "string"
          },
          "button": {
            "enum": [
              "left",
              "right",
              "middle"
            ],
            "type": "string"
          },
          "capture_id": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "debug_image_out": {
            "type": "string"
          },
          "delivery_mode": {
            "enum": [
              "background",
              "foreground"
            ],
            "type": "string"
          },
          "element_token": {
            "type": "string"
          },
          "from_zoom": {
            "type": "boolean"
          },
          "modifier": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pid": {
            "type": "integer"
          },
          "post_action_wait": {
            "enum": [
              "default",
              "none"
            ],
            "type": "string"
          },
          "scope": {
            "enum": [
              "window",
              "desktop"
            ],
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "target": {
            "type": "object"
          },
          "window_id": {
            "type": "integer"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
