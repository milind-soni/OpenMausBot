{
  "about": [
    "Shared contract between OpenMausBot (server/extractor/contract.ts) and the openmaus-cloud Admin's relay.",
    "OMB sends POST <OMB_CLOUD_DECIDER_URL>/v1/extract with Authorization: Bearer <OMB_CLOUD_DECIDER_TOKEN>, the x-omb-seam header naming the seam, and `body` as JSON: { seam, fields, input } (the seam in both).",
    "The relay answers { values: { [field]: value | null }, model }, refuses any request whose `accepts` would be false, and answers 413 for one over the caps; OMB never sends one, and never retries a 413.",
    "Body cap: 256 KB counting each image's data as empty; then at most 4 images of at most 1 MB decoded each (so a raw body can reach about 6 MB).",
    "Clairic handles string, number and date fields only: on the person's own key OMB sends boolean fields to Clef-flash as yes/no questions (true at p >= 0.6, false at p <= 0.4, else null) and enum fields as choice questions over the same input, and sends Clairic a reference_date of today (workers-ai-clairic.json). The relay does the same on its side.",
    "Regenerate from the real contract code when it changes, and copy this file to the Admin."
  ],
  "endpoint": "/v1/extract",
  "header": "x-omb-seam",
  "limits": {
    "bodyBytesWithoutImages": 262144,
    "images": 4,
    "imageBytes": 1048576,
    "fields": 30,
    "fieldName": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
    "description": 300,
    "options": 50,
    "option": 100,
    "text": 200000,
    "imageMimes": [
      "image/png",
      "image/jpeg",
      "image/webp"
    ],
    "rawBodyBytes": 6291456
  },
  "seams": {
    "keyCheck": {
      "fields": {
        "ok": {
          "type": "boolean",
          "description": "Is this a connection check?"
        }
      },
      "input": {
        "text": "OpenMausBot is checking that an extraction-model key works."
      }
    },
    "inboxTriage": {
      "fields": {
        "sender": {
          "type": "string",
          "description": "Who sent it: the person's or the company's name."
        },
        "ask": {
          "type": "string",
          "description": "What the sender asks the reader to do, in a few words."
        },
        "deadline": {
          "type": "date",
          "description": "When what is asked for is due, if a date is given."
        },
        "amount": {
          "type": "number",
          "description": "An amount of money the email is about, if any."
        },
        "needs_reply": {
          "type": "boolean",
          "description": "Does the sender wait on a written reply from the reader?"
        },
        "kind": {
          "type": "enum",
          "description": "What kind of email this is.",
          "options": [
            "personal",
            "work",
            "newsletter",
            "receipt",
            "notification",
            "marketing",
            "other"
          ]
        }
      },
      "input": "text only, at most 8,000 characters, no images",
      "textMax": 8000
    },
    "botExtract": {
      "note": "A bot's own extract tool: any request within `limits`. Counted per machine per day."
    }
  },
  "requests": [
    {
      "name": "the key check",
      "seam": "keyCheck",
      "accepts": true,
      "body": {
