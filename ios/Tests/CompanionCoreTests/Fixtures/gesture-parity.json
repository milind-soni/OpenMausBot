{
  "cases": [
    {
      "name": "direct tap clicks once where the finger landed",
      "mode": "direct",
      "view": [
        1000,
        1000
      ],
      "frame": [
        1000,
        1000
      ],
      "driving": true,
      "steps": [
        {
          "touch": {
            "id": 1,
            "phase": "began",
            "x": 400,
            "y": 250,
            "t": 0
          }
        },
        {
          "touch": {
            "id": 1,
            "phase": "ended",
            "x": 400,
            "y": 250,
            "t": 0.05
          }
        }
      ],
      "expect": [
        {
          "move": {
            "x": 0.4,
            "y": 0.25
          }
        },
        {
          "press": {
            "button": "left",
            "clicks": 1
          }
        },
        {
          "release": {
            "button": "left"
          }
        }
      ]
    },
