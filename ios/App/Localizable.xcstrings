{
  "sourceLanguage": "en",
  "strings": {
    "List density": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Densidade da lista"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表密度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列表密度"
          }
        }
      }
    },
    "Comfortable": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confortável"
          }
        },
        "zh-Hans": {
