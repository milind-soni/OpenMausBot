{
  "sourceLanguage": "en",
  "strings": {
    "Play voice note": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduzir nota de voz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放语音留言"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放語音留言"
          }
        }
      }
    },
    "Pause voice note": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar nota de voz"
          }
