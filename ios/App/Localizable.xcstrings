            "value": "新增其他帳戶"
          }
        }
      }
    },
    "Add the shared ElevenLabs key in this agent's profile on the computer. The key is never returned to iOS.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a chave compartilhada do ElevenLabs no perfil deste agente no computador. A chave nunca é devolvida ao iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在电脑上的此机器人设置档中加入共用的 ElevenLabs 密钥。密钥永远不会传回 iOS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在電腦上的此機器人設定檔中加入共用的 ElevenLabs 金鑰。金鑰永遠不會傳回 iOS。"
          }
        }
      }
    },
    "Add the shared Fish Audio key in OpenMausBot on your computer. The key is never returned to iOS.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a chave compartilhada do Fish Audio no OpenMausBot no computador. A chave nunca é devolvida ao iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在电脑上的 OpenMausBot 中加入共用的 Fish Audio 密钥。密钥永远不会传回 iOS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在電腦上的 OpenMausBot 中加入共用的 Fish Audio 金鑰。金鑰永遠不會傳回 iOS。"
          }
        }
      }
    },
