            "value": "緊湊"
          }
        }
      }
    },
    "Larger faces, with each bot’s latest message under its name.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostos maiores, com a última mensagem de cada bot abaixo do nome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像更大，机器人名称下会显示最新消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭像更大，機器人名稱下會顯示最新訊息。"
          }
        }
      }
    },
    "One line per bot. Bots with more than one active thread show how many; tap the number to list them.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha por bot. Bots com mais de uma thread ativa mostram quantas têm; toque no número para listá-las."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个机器人占一行。拥有多个活跃对话的机器人会显示对话数量；点按数字即可列出对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個機器人佔一行。擁有多個活躍對話的機器人會顯示對話數量；點按數字即可列出對話。"
          }
        }
      }
    },
    "New thread": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova thread"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
