          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用 cron 语法。每次运行都会使用机器人现有的模型、工具、权限、电脑与已连接的应用程序。时间依照已配对电脑的当地时区。"
          }
        },
