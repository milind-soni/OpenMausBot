    "Touch a bot, then glide. Pause briefly on each bot until it clicks.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um bot e deslize. Pause um instante em cada bot até ele encaixar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触碰机器人并滑动。依序停留在每个机器人上，直到听见点击声。"
          }
        },
