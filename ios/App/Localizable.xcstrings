    },
    "This existing Cloud VM choice is preserved, but it cannot run until the paired computer has a configured Boat API key and an available Boat agent.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta escolha de Cloud VM é mantida, mas não pode rodar enquanto o computador pareado não tiver uma chave de API do Boat configurada e um agente Boat disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留目前的云端 VM 选择，但必须先在已配对的电脑上设置 Boat API 密钥并备妥 Boat 代理程序，才能运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留目前的雲端 VM 選擇，但必須先在已配對的電腦上設定 Boat API 金鑰並備妥 Boat 代理程式，才能執行。"
          }
        }
      }
    },
    "This gives this device full control of the cloud computer, including anything signed in inside it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto dá a este dispositivo controle total do computador na nuvem, incluindo tudo que estiver conectado dentro dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
