          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时通话会将你的语音连同聊天的近期消息、机器人的回答，以及它请求的任何核准的详细信息一起发送至 OpenAI。OpenAI 密钥会保留在你的电脑上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時通話會將你的語音連同聊天的近期訊息、機器人的回答，以及它請求的任何核准的詳細資訊一起傳送至 OpenAI。OpenAI 金鑰會保留在你的電腦上。"
          }
        }
      }
    },
