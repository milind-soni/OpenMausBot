    "Allow camera access to scan the pairing QR code shown by OpenMausBot.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera para escanear o QR code de pareamento mostrado pelo OpenMausBot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用相机扫描 OpenMausBot 显示的配对 QR Code。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許使用相機掃描 OpenMausBot 顯示的配對 QR Code。"
          }
