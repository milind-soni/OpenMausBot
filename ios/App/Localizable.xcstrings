          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 Apple 密碼、1Password、Bitwarden，或直接貼上。資料會加密傳送至你的電腦，絕不會加入聊天內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
