    "000000": {
      "shouldTranslate": false
    },
    "5–1,440": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "5–1.440"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5–1,440"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5–1,440"
          }
        }
      }
    },
    "A section can have one Chief. Go back and choose one Chief, or use a section without one.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma seção pode ter um Chefe. Volte e escolha um Chefe, ou use uma seção sem nenhum."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個區段只能有一位 Chief。請返回並選擇一位 Chief，或改用沒有 Chief 的區段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个区段只能有一位 Chief。请返回并选择一位 Chief，或改用没有 Chief 的区段。"
          }
        }
      }
    },
    "A task is one conversation and result, with its own context and working folder.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa é uma conversa e um resultado, com contexto e pasta de trabalho próprios."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一項任務包含一段對話與結果，並有自己的上下文和工作資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一项任务包含一段对话与结果，并有自己的上下文和工作文件夹。"
          }
        }
      }
    },
    "Account alias": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apelido da conta"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶別名"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帐户别名"
          }
        }
      }
    },
    "Account details are unavailable from this provider. Refresh after authorization finishes.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor não fornece os detalhes da conta. Atualize depois que a autorização terminar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供者無法取得帳戶詳細資料。授權完成後請重新整理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供者无法取得帐户详细数据。授权完成后请刷新。"
          }
        }
      }
    },
    "Accounts could not be re-checked": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
