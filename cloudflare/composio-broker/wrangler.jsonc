{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openmausbot-composio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "COMPOSIO_API_BASE": "https://backend.composio.dev/api/v3.1",
    "COMPOSIO_TOOLKIT_BASE": "https://backend.composio.dev/api/v3",
    "REGISTRATION_MODE": "open"
  },
  "secrets": { "required": ["COMPOSIO_API_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmausbot-composio",
      "database_id": "435bcde1-c017-416f-b041-7ffc508e9d88",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "REGISTRATION_LIMITER", "namespace_id": "8261701", "simple": { "limit": 30, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "8261702", "simple": { "limit": 120, "period": 60 } },
    { "name": "EVENTS_LIMITER", "namespace_id": "8261703", "simple": { "limit": 60, "period": 60 } },
    { "name": "LINK_LIMITER", "namespace_id": "8261704", "simple": { "limit": 60, "period": 60 } }
  ],
  // One object per Grok Bot link (src/grok-link.ts): the desktop's socket and the calls waiting on it.
  "durable_objects": { "bindings": [{ "name": "GROK_LINK", "class_name": "GrokLinkObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GrokLinkObject"] }],
  // Hourly: expire app events older than 7 days, pause the triggers of installations idle for 14 days, delete Grok Bot
  // links no desktop attached to for 30 days.
  "triggers": { "crons": ["23 * * * *"] },
  "observability": {
    "enabled": true,
    // Security: invocation logs record each request's URL, and a Grok Bot link's URL is all a caller needs.
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
