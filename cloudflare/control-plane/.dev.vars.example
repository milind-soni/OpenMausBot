# Local-only placeholders. Copy this file to .dev.vars and replace the secret.
BETTER_AUTH_URL=https://auth.openmausbot.test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-cloudflare-api-token
EMAIL_FROM=noreply@openmausbot.test
ALLOWED_ORIGINS=https://app.openmausbot.test
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_ZONE_ID=00000000000000000000000000000000
COMPANION_HOST_SUFFIX=openmausbot.test
# Optional further Cloudflare accounts for managed endpoints (README "Several
# Cloudflare accounts"). Each entry names the secret that holds its token.
# CLOUDFLARE_ENDPOINT_ACCOUNTS='[{"accountId":"11111111111111111111111111111111","zoneId":"22222222222222222222222222222222","companionHostSuffix":"mausbot.test","apiTokenSecret":"CLOUDFLARE_API_TOKEN_SECOND"}]'
# CLOUDFLARE_API_TOKEN_SECOND=replace-with-a-second-scoped-cloudflare-api-token
