{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "/swarm/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/swarm/",
      "permanent": true
    },
    {
      "source": "/connectors/:path*",
      "destination": "/swarm/connectors",
      "permanent": false
    },
    {
      "source": "/plugins/:path*",
      "destination": "/swarm/connectors",
      "permanent": false
    },
    {
      "source": "/integrations/:path*",
      "destination": "/swarm/connectors",
      "permanent": false
    },
    {
      "source": "/marketplace/:path*",
      "destination": "/swarm/connectors",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/swarm/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/swarm/admin/index.html"
    },
    {
      "source": "/swarm/api/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/:path*"
    },
    {
      "source": "/swarm/.well-known/nationteamchat/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/.well-known/nationteamchat/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/api/:path*"
    },
    {
      "source": "/.well-known/nationteamchat/:path*",
      "destination": "https://server.aurk.org/nation-team-chat/.well-known/nationteamchat/:path*"
    },
    {
      "source": "/subscription",
      "destination": "/swarm/index.html"
    },
    {
      "source": "/subscription/",
      "destination": "/swarm/index.html"
    },
    {
      "source": "/swarm",
      "destination": "/swarm/index.html"
    },
    {
      "source": "/swarm/ledger",
      "destination": "/swarm/ledger/index.html"
    },
    {
      "source": "/swarm/ledger/",
      "destination": "/swarm/ledger/index.html"
    },
    {
      "source": "/swarm/admin",
      "destination": "/swarm/admin/index.html"
    },
    {
      "source": "/swarm/admin/",
      "destination": "/swarm/admin/index.html"
    },
    {
      "source": "/swarm/((?!assets/).*)",
      "destination": "/swarm/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "cursor/nation-rebrand-zero-fingerprints-9a8c": false,
      "nation-scrub-openmuse": false,
      "nation-remove-connectors": false,
      "nation-crypto-credits": false
    }
  },
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
