# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=astra
ASTRA_BIND_ADDRESS=127.0.0.1
ASTRA_HTTP_PORT=8080
# Leave empty to use http://localhost:${ASTRA_HTTP_PORT:-8080}.
ASTRA_PUBLIC_URL=
# Leave empty to inherit ASTRA_PUBLIC_URL.
ASTRA_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set ASTRA_PUBLIC_URL to https:// followed by the same hostname.
# Requires ASTRA_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
ASTRA_HTTPS_HOST=
ASTRA_BASE_IMAGE=ghcr.io/milind-soni/astra:latest
ASTRA_LOCAL_IMAGE=astra-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
ASTRA_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
ASTRA_DATA_EXTERNAL=false
